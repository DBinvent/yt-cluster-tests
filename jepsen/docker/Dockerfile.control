# [jepsen] The control node: JDK 21 and JNA (Jepsen's needs), graphviz (Elle draws
# the anomalies it finds), git (a test's start logs the revision it runs from),
# Leiningen, ssh to the nodes - and the test, its
# dependencies fetched and compiled at build, so a run needs no network. No
# gnuplot: performance graphs are left out.
FROM debian:trixie-slim
RUN apt-get update \
 && apt-get install -y --no-install-recommends openjdk-21-jdk-headless libjna-java graphviz \
      openssh-client git curl ca-certificates \
 && rm -rf /var/lib/apt/lists/*
# Leiningen from its Codeberg release, both files pinned by checksum (the script's
# own LEIN_CHECKSUM is the jar's): the script would fetch the jar from GitHub,
# where the release is not, so the jar is put where the script looks first
ARG LEIN_VERSION=2.12.0
ARG LEIN_SH_SHA256=f8e1266c0c78c08bd4af6e111889ecc316c9dd56d1e8645bbee6c1703d351bc3
ARG LEIN_JAR_SHA256=b721a573af631784f27ccb52e719e6d1287d9d3951ad56d316d38f7ecfa81aa2
ENV LEIN_ROOT=1
RUN curl -fsSL -o /usr/local/bin/lein \
      "https://codeberg.org/leiningen/leiningen/raw/tag/${LEIN_VERSION}/bin/lein" \
 && echo "${LEIN_SH_SHA256}  /usr/local/bin/lein" | sha256sum -c - \
 && chmod 755 /usr/local/bin/lein \
 && mkdir -p /root/.lein/self-installs \
 && curl -fsSL -o "/root/.lein/self-installs/leiningen-${LEIN_VERSION}-standalone.jar" \
      "https://codeberg.org/leiningen/leiningen/releases/download/${LEIN_VERSION}/leiningen-${LEIN_VERSION}-standalone.jar" \
 && echo "${LEIN_JAR_SHA256}  /root/.lein/self-installs/leiningen-${LEIN_VERSION}-standalone.jar" | sha256sum -c - \
 && lein version
RUN mkdir -p /root/.ssh && chmod 700 /root/.ssh
WORKDIR /jepsen
COPY project.clj ./
RUN lein deps
COPY src ./src
RUN lein check
CMD ["sleep", "infinity"]
